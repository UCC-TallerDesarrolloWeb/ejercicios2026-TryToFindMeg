{
  "info": {
    "name": "Unidad 7 - Análisis de PokeAPI",
    "description": "Ejercicio 2: consultar Bulbasaur con GET y analizar la respuesta. No requiere autenticación ni cuerpo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Bulbasaur",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://pokeapi.co/api/v2/pokemon/1",
          "protocol": "https",
          "host": [
            "pokeapi",
            "co"
          ],
          "path": [
            "api",
            "v2",
            "pokemon",
            "1"
          ]
        },
        "description": "Obtiene el Pokémon con id 1. Se esperan HTTP 200, JSON e identificación de Bulbasaur."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta HTTP 200 OK\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Contenido en formato JSON\", function () {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"El recurso corresponde a Bulbasaur\", function () {",
              "  const pokemon = pm.response.json();",
              "  pm.expect(pokemon.id).to.eql(1);",
              "  pm.expect(pokemon.name).to.eql(\"bulbasaur\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
